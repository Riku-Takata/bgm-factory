# This file is copied to D:\HomeServer\config\bgm-factory\.env by install.ps1.
BGM_FACTORY_TIMEZONE=Asia/Tokyo
BGM_FACTORY_API_HOST=127.0.0.1
BGM_FACTORY_API_PORT=8765
BGM_FACTORY_AUTO_UPLOAD=false

ACESTEP_API_HOST=127.0.0.1
ACESTEP_API_PORT=8001
ACESTEP_CONFIG_PATH=acestep-v15-turbo
ACESTEP_LM_MODEL_PATH=acestep-5Hz-lm-0.6B
ACESTEP_LM_BACKEND=pt
ACESTEP_INIT_LLM=auto
ACESTEP_OFFLOAD_TO_CPU=true
ACESTEP_DOWNLOAD_SOURCE=huggingface
ACESTEP_CHECK_UPDATE=false

# install.ps1 replaces this placeholder with a random local API key.
ACESTEP_API_KEY=CHANGE_ME

# YouTube remains disabled until OAuth is configured and verified.
YOUTUBE_CLIENT_SECRET_FILE=D:\HomeServer\config\bgm-factory\secrets\client_secret.json
YOUTUBE_TOKEN_FILE=D:\HomeServer\config\bgm-factory\secrets\token.json

# Free stock-video API. Keep the real key only in the server config .env file.
PEXELS_API_KEY=CHANGE_ME
